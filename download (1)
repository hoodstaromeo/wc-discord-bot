import {
  SlashCommandBuilder,
  EmbedBuilder,
  PermissionFlagsBits,
} from "discord.js";

const STATUS_CONFIG = {
  basladi: {
    color: 0xed4245,
    emoji: "🛠️",
    title: "SUNUCU BAKIMA ALINDI",
    status: "BAKIMDA",
    closing: "Bakım tamamlandığında ayrıca bilgilendirme yapılacaktır.",
  },
  guncelleme: {
    color: 0xfee75c,
    emoji: "⚙️",
    title: "BAKIM ÇALIŞMASI DEVAM EDİYOR",
    status: "İŞLEM SÜRÜYOR",
    closing: "Ekibimiz işlemleri tamamlamak için çalışmaya devam ediyor.",
  },
  tamamlandi: {
    color: 0x57f287,
    emoji: "✅",
    title: "BAKIM TAMAMLANDI",
    status: "SUNUCU AÇIK",
    closing: "Sunucu yeniden oyuncu girişlerine açılmıştır. İyi roller!",
  },
  iptal: {
    color: 0x5865f2,
    emoji: "ℹ️",
    title: "BAKIM İPTAL EDİLDİ",
    status: "İPTAL",
    closing: "Planlanan bakım ileri bir tarihe ertelenmiştir.",
  },
};

export default {
  data: new SlashCommandBuilder()
    .setName("bakım")
    .setDescription("Sunucu bakım duyurusu gönderir")
    .setDefaultMemberPermissions(PermissionFlagsBits.ManageGuild)
    .addStringOption((option) =>
      option
        .setName("durum")
        .setDescription("Bakım duyurusunun türü")
        .setRequired(true)
        .addChoices(
          { name: "Bakım başladı", value: "basladi" },
          { name: "Bakım güncellemesi", value: "guncelleme" },
          { name: "Bakım tamamlandı", value: "tamamlandi" },
          { name: "Bakım iptal edildi", value: "iptal" }
        )
    )
    .addStringOption((option) =>
      option.setName("sebep").setDescription("Bakımın sebebi").setMaxLength(500)
    )
    .addStringOption((option) =>
      option.setName("süre").setDescription("Tahmini süre: 30 dakika, 1 saat vb.").setMaxLength(100)
    )
    .addStringOption((option) =>
      option.setName("işlemler").setDescription("Yapılan/yapılacak işlemler").setMaxLength(700)
    )
    .addStringOption((option) =>
      option.setName("not").setDescription("Oyunculara ek açıklama").setMaxLength(500)
    )
    .addBooleanOption((option) =>
      option.setName("etiketle").setDescription("Bakım rolünü veya @everyone'ı etiketle")
    ),

  async execute(interaction) {
    if (!interaction.memberPermissions?.has(PermissionFlagsBits.ManageGuild)) {
      return interaction.reply({
        content: "❌ Bu komutu kullanmak için **Sunucuyu Yönet** yetkisine sahip olmalısın.",
        ephemeral: true,
      });
    }

    const statusKey = interaction.options.getString("durum", true);
    const config = STATUS_CONFIG[statusKey];
    const reason = interaction.options.getString("sebep") || "Genel optimizasyon ve sistem kontrolleri";
    const duration = interaction.options.getString("süre") || "Henüz net değil";
    const operations =
      interaction.options.getString("işlemler") ||
      "• Sistem kontrolleri\n• Script ve performans iyileştirmeleri\n• Hata düzeltmeleri";
    const note = interaction.options.getString("not") || config.closing;
    const shouldMention = interaction.options.getBoolean("etiketle") ?? true;
    const roleId = process.env.MAINTENANCE_ROLE_ID?.trim();
    const logoUrl = process.env.SERVER_LOGO_URL?.trim();

    const embed = new EmbedBuilder()
      .setColor(config.color)
      .setAuthor({ name: "WEST CARSON ROLEPLAY", iconURL: logoUrl || undefined })
      .setTitle(`${config.emoji} ${config.title}`)
      .setDescription(
        `Değerli oyuncularımız,\n\nSunucumuzda daha stabil ve kaliteli bir oyun deneyimi sağlamak amacıyla bakım çalışması uygulanmaktadır.`
      )
      .addFields(
        { name: "📌 Durum", value: `\`${config.status}\``, inline: true },
        { name: "⏱️ Tahmini Süre", value: duration, inline: true },
        { name: "👤 Yetkili", value: `${interaction.user}`, inline: true },
        { name: "🔧 Bakım Sebebi", value: reason },
        { name: "📋 Yapılan İşlemler", value: operations },
        { name: "📢 Bilgilendirme", value: note }
      )
      .setFooter({ text: "West Carson Yönetim Ekibi • Anlayışınız için teşekkür ederiz" })
      .setTimestamp();

    if (logoUrl) embed.setThumbnail(logoUrl);

    let content;
    const allowedMentions = { parse: [] };

    if (shouldMention) {
      if (roleId) {
        content = `<@&${roleId}>`;
        allowedMentions.roles = [roleId];
      } else {
        content = "@everyone";
        allowedMentions.parse = ["everyone"];
      }
    }

    await interaction.reply({ content, embeds: [embed], allowedMentions });
  },
};
